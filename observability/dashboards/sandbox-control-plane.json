{
  "annotations": {
    "list": []
  },
  "description": "Sandbox control plane: admission, cold starts, the control-plane store and the object-store queue. Every series here is tenant-free by design (control_plane/core.py::METRICS) - per-tenant numbers come from the authenticated /v1/admin routes, not from here.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(sandbox_runtimes_live)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Live runtimes",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
