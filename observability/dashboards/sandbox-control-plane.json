          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sandbox_runtime_create_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sandbox_runtime_create_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
